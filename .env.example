# e-Arzuhal NLP Server Environment Variables

# Server
# Production'da loopback kullan: HOST=127.0.0.1
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Main Server (Java backend)
MAIN_SERVER_URL=http://localhost:8080

# spaCy (opsiyonel)
# USE_SPACY=false -> her zaman regex/lite mod
USE_SPACY=true
# REQUIRE_SPACY=true -> spaCy yoksa/model yoksa startup fail
REQUIRE_SPACY=false
# ALLOW_SPACY_DOWNLOAD=true -> runtime'da model indirmeyi dener (opsiyonel)
ALLOW_SPACY_DOWNLOAD=false
SPACY_MODEL=tr_core_news_sm

# Güvenlik (Production'da mutlaka set et)
# İzin verilen origin'ler (virgülle ayrılmış)
ALLOWED_ORIGINS=http://localhost:8080
# Dahili servis API anahtarı (main-server X-Internal-API-Key header'ında gönderir)
# openssl rand -hex 32 ile üret
INTERNAL_API_KEY=
