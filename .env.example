# e-Arzuhal NLP Server Environment Variables
# Kopyala -> .env olarak kaydet ve değerleri doldur
# UYARI: .env dosyasını asla git'e commit etme!

# ── Sunucu ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
DEBUG=true

# ── Ollama (Qwen 2.5 NER) ─────────────────────────────────────────────────────
# Docker ile çalışıyorsan: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
# Model adı — docker-compose entrypoint ile otomatik pull edilir
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# LLM isteği başına timeout (saniye)
OLLAMA_TIMEOUT=60

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# İzin verilen origin'ler (virgülle ayrılmış) — yalnızca main-server erişmeli
ALLOWED_ORIGINS=http://localhost:8080
# Dahili servis API anahtarı — main-server'daki INTERNAL_API_KEY ile aynı olmalı
# openssl rand -hex 32 ile üret
INTERNAL_API_KEY=

# ── Loglama ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
